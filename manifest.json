{
  "manifest_version": 3,
  "name": "Word Definer AI",
  "version": "2.0",
  "description": "Instant dictionary with context-aware AI explanation powered by Gemini.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
      "https://api.datamuse.com/*",
      "https://generativelanguage.googleapis.com/*",
      "http://localhost:8000/*",
      "<all_urls>"
    ],  
  "action": {
    "default_title": "Word Definer AI",
    "default_popup": "popup.html"
  },
  "sidebar_action": {
    "default_title": "Word Definer AI",
    "default_panel": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "word-definer@praneet.local"
    }
  }
}